#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Read numbers and calculate sum
    int sum = 0;

    for (int i = 0; i < n; i++) {
        int number;
        scanf("%d", &number);

        sum = sum + number;
    }

    // Print the sum
    printf("Sum = %d\n", sum);

    return 0;
}
