#include<stdio.h>


int lcm(int a,int b)
{
    
    int i;
    
    for(i=1;;i++)
    {
        
        if(i%a==0 && i%b==0)
        {
            break;
        }
        
    }
    
    return i;



}


int main()
{
    
    int a,b;
    scanf("%d %d",&a,&b);
    printf("%d",lcm(a,b));
    
    return 0;




}
