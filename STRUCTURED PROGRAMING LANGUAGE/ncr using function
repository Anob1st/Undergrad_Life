#include<stdio.h>

int fact(int n){
    
    int result=1;
    
    
    for(int i=1; i<=n ;i++)
    {
    
    result=result*i;
    }
    
    return result;
}

int ncr(int n, int r) {
    
    
    
    return fact(n)/(fact(r)*fact(n-r));
    
}


int main() {
    int n,r;
    
    
    
    scanf("%d %d", &n,&r);
    fact(n);
    fact(r);
    printf("%d", ncr(n,r));
    
    return 0;
    
}

