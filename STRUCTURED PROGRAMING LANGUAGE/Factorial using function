#include<stdio.h>

int factorialFunc(int n){
    int result=1;
    int i;
    
    for(i=1;i<=n;i++){
        
        result=result*i;
    }
    
    return result;
    
}

int main()
{
    int n;
    
    printf("kotor factorial ber korbi?: ");
    scanf("%d", &n);
    
    
    printf("%d",factorialFunc(n));
    return 0;
    
}
